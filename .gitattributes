# LF everywhere, in the index and the working copy: the stamp hashes dist/
# file bytes and CI checks out LF, and one ending across the repository keeps
# Windows commits free of CRLF warnings and whole-file diffs.
* text=auto eol=lf
# cmd.exe misreads labels and line continuations in an LF batch file.
*.bat text eol=crlf
*.pdf binary
*.png binary
*.jpg binary
*.webp binary
*.woff2 binary
